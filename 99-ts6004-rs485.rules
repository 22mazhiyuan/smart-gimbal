# TS6004-10 USB-RS485 转接器 udev 规则（模板，未启用）
#
# 2026-10-09 用户插拔确认：序列号 9cf94d227a89ef11a6c5ad95ef8776e9 是，
# 不是新转接器。旧云台和新转接器都是 CP2102N（VID:PID 10c4:ea60），
# 只能靠序列号区分 —— 规则里不写序列号就敢启用，会把命令发到旧云台上。
#
# 启用步骤：
# 1. 把新 RS485 转接器插上（旧云台保持插着也行）
# 2. Codex 跑：ls /dev/serial/by-id/ 和 udevadm info -n /dev/ttyUSBx | grep SERIAL_SHORT
# 3. 找出新转接器的序列号，填进下面 ATTRS{serial} 和 config.yaml 的 serial
# 4. sudo cp 99-ts6004-rs485.rules /etc/udev/rules.d/
# sudo udevadm control --reload-rules && sudo udevadm trigger
# 生效后固定路径：/dev/ts6004_rs485

# SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="新转接器序列号填这里", SYMLINK+="ts6004_rs485", MODE="0666"
