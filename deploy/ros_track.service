[Unit]
Description=Existing camera RTSP and ros_track runtime (shared process)

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/visual_gimbal_lab/multirotor_accuracy_repair_20261009
Environment=ROS_DOMAIN_ID=99
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source /home/jetson/anti_drone_ws/install/setup.bash && exec /bin/bash /home/jetson/visual_gimbal_lab/multirotor_accuracy_repair_20261009/start_detector.sh'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
Alias=rtsp_stream.service
